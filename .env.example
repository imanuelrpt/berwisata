# ============================================================
# BerWisata - Environment Configuration
# Copy to .env and adjust values
# ============================================================

# --- Application ---
APP_NAME=BerWisata
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://berwisata:berwisata@localhost:5432/berwisata

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Storage ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif

# --- External APIs ---
# OpenRouteService (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=
# Open-Meteo weather API (free, no key required)
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# --- Machine Learning ---
ML_MODEL_PATH=app/ml/models/hidden_gem_model.joblib
ML_SCALER_PATH=app/ml/models/scaler.joblib
ML_ENCODER_PATH=app/ml/models/label_encoders.joblib
ML_FEATURES_PATH=app/ml/models/feature_columns.joblib
ML_TRAIN_SPLIT=0.8
ML_USE_CACHED_MODEL=true

# --- WebSocket ---
WS_MAX_CLIENTS=5000
WS_LOCATION_UPDATE_INTERVAL=10

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL=2000/minute
RATE_LIMIT_AUTH=30/minute

# --- Redis (optional, fallback to in-memory) ---
REDIS_URL=

# --- Frontend (Vite) ---
# Relative path works when served by the nginx proxy in Docker
VITE_API_URL=/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_ORS_API_KEY=
